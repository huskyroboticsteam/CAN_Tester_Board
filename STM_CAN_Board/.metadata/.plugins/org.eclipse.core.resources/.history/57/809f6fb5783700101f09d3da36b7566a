/**
 * @brief Processes incoming UART characters and sends a corresponding CAN message.
 *
 * This function reads a character from UART, stores it in a buffer, and processes the
 * command when a carriage return ('\r') is received. If a valid command is detected,
 * it constructs a CAN message and attempts to send it via the CAN bus.
 *
 */
void processUARTtoCAN(void) {
    uint8_t c;

    if (HAL_UART_Receive(UART_HANDLE, &c, 1, 10) == HAL_OK) {  // Read one byte with timeout
        if (c == '\r') {  // If Enter key pressed, process command

            // Check if all mailboxes are full
            if (HAL_CAN_GetTxMailboxesFreeLevel(CAN_HANDLE) <= 0) {
                Print("Mailboxes Full! Aborting the oldest message...\r\n");

                // Identify the oldest pending mailbox and abort only one
                if (HAL_CAN_IsTxMessagePending(CAN_HANDLE, CAN_TX_MAILBOX0)) {
                    HAL_CAN_AbortTxRequest(CAN_HANDLE, CAN_TX_MAILBOX0);
                    Print("Aborted TX Mailbox 0\r\n");
                } else if (HAL_CAN_IsTxMessagePending(CAN_HANDLE, CAN_TX_MAILBOX1)) {
                    HAL_CAN_AbortTxRequest(CAN_HANDLE, CAN_TX_MAILBOX1);
                    Print("Aborted TX Mailbox 1\r\n");
                } else if (HAL_CAN_IsTxMessagePending(CAN_HANDLE, CAN_TX_MAILBOX2)) {
                    HAL_CAN_AbortTxRequest(CAN_HANDLE, CAN_TX_MAILBOX2);
                    Print("Aborted TX Mailbox 2\r\n");
                }
            }

            // 1. Parse UART to CAN Packet
            parseLine(&canTxHeader, uart_rx + 1, uart_rx_len - 1);
            Print("\r\n------------------------------------ \r\nAttempting to CAN send: ");
            Print(uart_rx);
            Print("\r\n");

            // 2. Send if there is a free mailbox
            if (HAL_CAN_GetTxMailboxesFreeLevel(CAN_HANDLE) > 0) {
                if (HAL_CAN_AddTxMessage(CAN_HANDLE, &canTxHeader, canTxData, &canTxMailbox) == HAL_OK) {

                	// Message successfully queued to the mailbox
                	sprintCANPacket(&canTxHeader, uart_tx);
                    Print("Queued CAN message: ");
                    Print(uart_tx);

                    // Check if transmitted
					while (HAL_CAN_IsTxMessagePending(CAN_HANDLE, canTxMailbox)) {
						HAL_Delay(10);  // Small delay to allow message to transmit
					}

					// Message was successfully sent out
					Print("CAN message sent successfully.\r\n");


                } else {
                    Print("CAN Tx queued but failed to send! Check CAN receiver connection.\r\n");
                    Error_Handler();
                }
            } else {
            	Print("No free mailbox! Message was not sent. Check CAN receiver connection. \r\n");
            }

            Print("------------------------------------ \r\n \r\n");

            // Reset UART buffer
            uart_rx_len = 0;
            memset(uart_rx, 0, sizeof(uart_rx));
        } else {
            uart_rx[uart_rx_len] = c;
            uart_rx_len++;
        }
    }
}

/**
 * @brief Converts a single hexadecimal character (0-9, A-F, a-f) to its decimal equivalent.
 *
 * @param c The hexadecimal character to convert.
 * @return uint8_t The decimal equivalent of the hex character (0-15).
 */
uint8_t s2x(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    return 0;  // Default case: return 0 if not a valid hex character
}

/**
 * @brief Parses a UART command string into a CANPacket structure.
 *
 * This function extracts the CAN ID from the input string and converts hex pairs
 * into CAN data bytes.
 *
 * @param p Pointer to the CANPacket structure to store the parsed data.
 * @param line Character array containing the command string.
 * @param length Length of the input string.
 */
void parseLine(CANPacket* p, char line[], int length) {
    if (length < 6) return;  // Minimum length check to avoid buffer overflows

    // Extract ID components
    uint16_t pr = (uint16_t) s2x(line[0]) << 10;
    uint16_t dg = (uint16_t) s2x(line[2]) << 6;
    uint16_t sn = (uint16_t) s2x(line[4]) << 4 | s2x(line[5]);

    p->id = (pr | dg | sn);  // Combine into a single CAN ID

    // Extract CAN Data
    int i = 0, j = 8;  // Start parsing from index 8 (where data begins)
    while (j < length && i < 8) {
        if (line[j-1] != ' ' && line[j] != ' ') {  // Ignore spaces
            p->data[i] = (s2x(line[j-1]) << 4) | s2x(line[j]);  // Convert hex pair to byte
            i++;
        }
        j += 3;  // Move to next hex pair (assuming "XX XX XX" format)
    }
    p->dlc = i;  // Store the number of valid data bytes
}

/**
 * @brief Formats a CANPacket structure into a human-readable string.
 *
 * The function extracts CAN ID fields and converts data bytes into a
 * formatted string representation for easy UART transmission.
 *
 * @param packet Pointer to the CANPacket structure containing the CAN message.
 * @param buffer Character array where the formatted string will be stored.
 */
void sprintCANPacket(CANPacket* packet, char* buffer) {
    if (!packet || !buffer) return;  // Null pointer check

    // Extract priority, device group, and serial number
    uint8_t pri = (packet->id & 0x400) >> 10;
    uint8_t dg  = (packet->id & 0x3C0) >> 6;
    uint8_t sn  = (packet->id & 0x03F);

    // Format the ID part
    int len = sprintf(buffer, "%01X %02X %02X ", pri, dg, sn);

    // Format the data part (DLC determines how many bytes to print)
    for (int i = 0; i < packet->dlc; i++) {
        len += sprintf(buffer + len, "%02X ", packet->data[i]);
    }

    // Append newline
    sprintf(buffer + len, "\r\n");
}

/**
 * @brief Sends a message over UART.
 *
 * This function transmits a string over UART using HAL_UART_Transmit.
 *
 * @param msg Pointer to the null-terminated string to be transmitted.
 */
void Print(const char *msg) {
    HAL_UART_Transmit(UART_HANDLE, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
}

